# Atreya: SPA routing + caching + hardening for Apache/LiteSpeed shared hosting
RewriteEngine On
RewriteBase /

# Keep LiteSpeed's server-side page cache away from responses; browsers
# already get correct Cache-Control headers below.
<IfModule LiteSpeed>
  RewriteRule .* - [E=Cache-Control:no-cache]
</IfModule>

# Canonical host: force https and apex domain in one 301
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.atreya\.store$ [NC]
RewriteRule ^(.*)$ https://atreya.store/$1 [R=301,L]

# No directory listings for the asset folders
RewriteRule ^(assets|products)/?$ - [R=404,L]

# Never rewrite build assets or product images: a missing asset must 404,
# not silently return index.html (poisons browsers after a redeploy).
RewriteRule ^(assets|products)/ - [L]

# Bare /product is a snapshot directory, not a page; send to the SPA shell
RewriteRule ^product/?$ /index.html [L]

# A /product/<ASIN> with no prerendered snapshot is a product we no longer sell.
# Serving the SPA shell with a 200 makes it look live to Google (soft 404), which
# is how delisted items linger in the index. Return a real 404 so it drops out.
# ErrorDocument below supplies the page body.
RewriteCond %{DOCUMENT_ROOT}/product/$1.html !-f
RewriteRule ^product/([^/]+)/?$ - [R=404,L]

# Serve prerendered snapshots: /shop → /shop.html, /product/X → /product/X.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*?)/?$ /$1.html [L]

# Everything else falls through to the SPA shell
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-l
RewriteRule . /index.html [L]

ErrorDocument 404 /404.html

# Cache policy: HTML always revalidates; hashed build assets cache forever
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|mjs|css|woff|woff2|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>
